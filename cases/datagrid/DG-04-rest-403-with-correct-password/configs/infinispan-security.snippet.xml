<!-- Excerpt from the customer's server/conf/infinispan.xml. NOT a complete configuration. -->
<server xmlns="urn:infinispan:server:15.0">
    <security>
        <security-realms>
            <security-realm name="default">
                <!-- the properties realm stores credentials HASHED, so Basic cannot be
                     validated against them; the endpoint offers DIGEST -->
                <properties-realm groups-attribute="Roles">
                    <user-properties path="users.properties"/>
                    <group-properties path="groups.properties"/>
                </properties-realm>
            </security-realm>
        </security-realms>
    </security>
    <endpoints socket-binding="default" security-realm="default">
        <endpoint>
            <hotrod-connector/>
            <rest-connector>
                <authentication mechanisms="DIGEST BASIC"/>
            </rest-connector>
        </endpoint>
    </endpoints>
</server>
