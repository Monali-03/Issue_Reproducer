<?xml version="1.0" encoding="UTF-8"?>
<!-- The customer's descriptor, carried over unchanged from EAP 7.4 (Jakarta EE 8).
     EAP 8.x is Jakarta EE 10: the namespace and the servlet API package both moved.
     A WAR built against javax.* DEPLOYS SUCCESSFULLY here and 404s on every path. -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>orders</display-name>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
