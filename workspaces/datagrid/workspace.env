# workspace.env — Red Hat Data Grid / Infinispan server

WS_NAME="datagrid"
WS_PRODUCT="datagrid"
WS_PRODUCT_LABEL="Red Hat Data Grid / Infinispan"

# Empty: Data Grid majors (8.x) and Infinispan majors (14.x, 15.x) describe the same
# releases, so a major-number equality check would reject correct cases. The product
# pattern below is what isolates this workspace.
WS_MAJOR=""

WS_PRODUCT_MATCH='data ?grid|infinispan|rhdg|jdg'
WS_PRODUCT_EXCLUDE='eap|enterprise application platform|wildfly'

# --- port block (disjoint from every other workspace) -------------------------
# Node i: single port 11222 + OFFSET_BASE + i*100  ->  13222 / 13322 / 13422
# The server's -o offset covers its socket bindings but NOT the JGroups bind port, which
# comes from a system property; the driver sets that per node:  9800 / 9900 / 10000
WS_BIND="127.0.0.1"
WS_OFFSET_BASE=2000

# --- defaults -----------------------------------------------------------------
WS_DEFAULT_NODES=2

# Credentials created on each server root before start. The realm stores them HASHED, so
# the harness authenticates with digest — Basic is rejected even when the password is right.
WS_DG_USER="admin"
WS_DG_PASS="reproPassw0rd!"

WS_CACHE_NAME="reprocache"
WS_ENTRY_COUNT=100

# --- JDK ----------------------------------------------------------------------
WS_DEFAULT_JDK=17
WS_SUPPORTED_JDKS="11 17 21"
WS_JDK_SOURCE="Red Hat's 'Data Grid Supported Configurations' article on the Customer
Portal. Confirm there before quoting it; used here only to pick a lab JDK."

# --- installation ---------------------------------------------------------------
WS_INSTALL_GLOB="$HOME/Documents/Datagrid/redhat-datagrid-*-server $HOME/Documents/EAP_lab/redhat-datagrid-*-server /opt/redhat-datagrid-*-server $HOME/infinispan-server-*"

# Set to 1 only if this host genuinely has working multicast between processes and you want
# the shipped discovery left alone. On a normal single host it does not, and every node
# forms a cluster of one.
DG_SKIP_TCPPING="${DG_SKIP_TCPPING:-0}"
