# workspace.env — JBoss EAP 8.x

WS_NAME="eap8"
WS_PRODUCT="eap"
WS_PRODUCT_LABEL="JBoss EAP 8.x"
WS_MAJOR="8"

WS_PRODUCT_MATCH='eap|enterprise application platform|wildfly'
WS_PRODUCT_EXCLUDE='data ?grid|infinispan|rhdg|jdg'

# --- port block (disjoint from every other workspace) -------------------------
#   http 9080/9180/9280 · mgmt 10990/11090/11190 · jgroups 8600/8700/8800
# Nothing here overlaps eap7 (8080-10190), datagrid (9800-13422) or jvm (no ports), so all
# four can run at once.
WS_BIND="127.0.0.1"
WS_OFFSET_BASE=1000

# --- defaults -----------------------------------------------------------------
WS_DEFAULT_NODES=2
WS_CONFIG_HA="standalone-ha.xml"
WS_CONFIG_SINGLE="standalone.xml"

# EAP 8.x is Jakarta EE 10: the servlet API lives under jakarta.*
#
# This is not cosmetic. A WAR built against javax.* DEPLOYS SUCCESSFULLY here and reports
# healthy while every servlet returns 404, because the annotations are never scanned. The
# driver therefore always proves the application by calling it, never by reading status.
WS_NS="jakarta"

# --- JDK ----------------------------------------------------------------------
WS_DEFAULT_JDK=17
# NOT 11. Verified against this installation, not recalled: booting EAP 8.1 on JDK 11 dies
# before it reads any configuration with
#   UnsupportedClassVersionError: org/jboss/as/clustering/infinispan/subsystem/
#   InfinispanExtension has been compiled by a more recent version of the Java Runtime
#   (class file version 61.0) ... only recognizes class file versions up to 55.0
# Class file 61 is Java 17, so the product's own modules set the floor. Listing 11 here made
# the JDK fallback pick it first and every node died at boot.
WS_SUPPORTED_JDKS="17 21"
WS_JDK_SOURCE="Red Hat's 'JBoss EAP 8 Supported Configurations' article on the Customer
Portal. Confirm there before quoting it to a customer; it is used here only to pick a lab
JDK and to warn when the case names one outside the list."

# --- installation ---------------------------------------------------------------
WS_INSTALL_GLOB="$HOME/Documents/EAP_lab/jboss-eap-8* /opt/jboss-eap-8* $HOME/jboss-eap-8* /opt/rh/eap8"
