# workspace.env — OpenJDK / HotSpot
#
# No server, no ports: the subject is the JVM itself running under the customer's flags.

WS_NAME="jvm"
WS_PRODUCT="jvm"
WS_PRODUCT_LABEL="OpenJDK / JVM"

# JDK majors run 8, 11, 17, 21, 25 — an equality check against a workspace major would be
# meaningless. The driver instead requires the exact JDK the case names and refuses to
# substitute another, because a JVM symptom is version-specific.
WS_MAJOR=""

WS_PRODUCT_MATCH='openjdk|jdk|jvm|hotspot|temurin|^ *java'
WS_PRODUCT_EXCLUDE='eap|enterprise application platform|wildfly|data ?grid|infinispan'

# No listening ports are used, so nothing here can collide with the other three workspaces.
WS_BIND="127.0.0.1"
WS_OFFSET_BASE=0
WS_DEFAULT_NODES=1

# --- workload -----------------------------------------------------------------
WS_DURATION="${WS_DURATION:-180}"            # seconds the workload runs
WS_THREADS="${WS_THREADS:-4}"                  # worker threads for the cpu / alloc modes
WS_SAMPLES="${WS_SAMPLES:-6}"                  # thread dumps + ps samples taken while the symptom is live
WS_SAMPLE_GAP="${WS_SAMPLE_GAP:-10}"          # seconds between samples

# Used only when the case states no pause requirement of its own. Declared here, before the
# run, so the threshold cannot be chosen to fit whatever came out.
WS_PAUSE_THRESHOLD_MS=1000

# Applied only when the case and input/configs/ supply no flags at all. A small heap is
# chosen on purpose: it makes a retention problem visible in minutes rather than hours.
WS_DEFAULT_OPTS="-Xms256m -Xmx512m"

WS_DEFAULT_JDK=17
WS_SUPPORTED_JDKS="8 11 17 21 25"
WS_JDK_SOURCE="whatever is installed on this host; see ./run.sh output for the list."
WS_INSTALL_GLOB=""
