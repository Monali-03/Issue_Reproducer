# workspace.env — JBoss EAP 7.x
#
# Everything that makes this workspace different from the other three. The drivers in lib/
# are version-agnostic and read their facts from here.

WS_NAME="eap7"
WS_PRODUCT="eap"
WS_PRODUCT_LABEL="JBoss EAP 7.x"
WS_MAJOR="7"

# Accepted / refused case products. 'jboss' alone is deliberately NOT accepted: older
# Data Grid shipped as "Red Hat JBoss Data Grid 7.x" and would otherwise pass both this
# pattern and the major check.
WS_PRODUCT_MATCH='eap|enterprise application platform|wildfly'
WS_PRODUCT_EXCLUDE='data ?grid|infinispan|rhdg|jdg'

# --- port block (disjoint from every other workspace) -------------------------
# Node i uses offset WS_OFFSET_BASE + i*100, applied to EAP's whole socket-binding group.
#   http 8080/8180/8280 · mgmt 9990/10090/10190 · jgroups 7600/7700/7800
WS_BIND="127.0.0.1"
WS_OFFSET_BASE=0

# --- defaults -----------------------------------------------------------------
WS_DEFAULT_NODES=2
WS_CONFIG_HA="standalone-ha.xml"
WS_CONFIG_SINGLE="standalone.xml"

# EAP 7.x is Jakarta EE 8: the servlet API lives under javax.*
WS_NS="javax"

# --- JDK ----------------------------------------------------------------------
WS_DEFAULT_JDK=11
WS_SUPPORTED_JDKS="8 11 17"
WS_JDK_SOURCE="Red Hat's 'JBoss EAP 7 Supported Configurations' article on the Customer
Portal. This list is NOT authoritative here — confirm it there before relying on it for a
customer answer. It is used only to choose a JDK for the lab and to warn when the case
names one outside it."

# --- installation ---------------------------------------------------------------
# First glob containing bin/standalone.sh wins; one level of nesting is searched too, since
# the archives unpack as jboss-eap-7.4.0/jboss-eap-7.4/. Override with EAP_HOME=... ./run.sh
WS_INSTALL_GLOB="$HOME/Documents/EAP_lab/jboss-eap-7* /opt/jboss-eap-7* $HOME/jboss-eap-7* /opt/rh/eap7"
