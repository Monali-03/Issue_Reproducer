# Topology and environment for this reproducer. Sourced by every script.
# This is the ONLY file that should need editing to move the package to another host.
# No script may hard-code an address, a port or a path that belongs here (spec §18).

# --- what the case asks for -------------------------------------------------
# Used by setup.sh to select/validate the product installation. A major-version
# mismatch is fatal: a verdict from the wrong major answers nothing.
TARGET_PRODUCT="JBoss EAP"       # JBoss EAP | Red Hat Data Grid | JWS | JBCS
TARGET_VERSION="7.4.23"
TARGET_MAJOR="7"
TARGET_JDK="11"                  # supported range resolved in reproduction-plan.md

# --- where things live ------------------------------------------------------
# Leave empty to let setup.sh autodiscover and validate against TARGET_* above.
EAP_HOME="${EAP_HOME:-}"
JAVA_HOME="${JAVA_HOME:-}"

# Extra roots for autodiscovery, colon-separated.
SEARCH_PATHS="${SEARCH_PATHS:-$HOME/Documents:$HOME/jboss:/opt}"

# --- topology ---------------------------------------------------------------
BIND_ADDR="127.0.0.1"

# name  http_port  mgmt_port  jgroups_port  base_dir(relative to package)
NODES=(
  "node1 8080 9990  7600 standalone-node1"
  "node2 8180 10090 7700 standalone-node2"
  "node3 8280 10190 7800 standalone-node3"
)

SERVER_CONFIG="standalone-ha.xml"

# --- load balancer ----------------------------------------------------------
LB_ENABLED="true"
LB_PORT="8090"
LB_STICKY="true"

# --- application ------------------------------------------------------------
# Blueprint chosen from the case (see .claude/skills/build-test-app):
#   session-cluster  clustering / session failover  (WAR, <distributable/>)
#   simple-web       non-clustered cases            (WAR)
#   cache-harness    Data Grid server               (REST driver, no WAR)
APP_BLUEPRINT="session-cluster"
APP_NAME="repro"
APP_CONTEXT="/repro"
APP_ENDPOINT="/repro/session"        # simple-web uses /repro/info

# Set to deploy the customer's own WAR/EAR instead of a blueprint — higher fidelity.
CUSTOMER_WAR=""

# --- Data Grid (cache-harness only) -----------------------------------------
DG_HOSTS="127.0.0.1:11222 127.0.0.1:11322 127.0.0.1:11422"
DG_USER="admin"
DG_PASS="password"
CACHE_NAME="reprocache"
ENTRY_COUNT="100"

# --- reproduction tuning ----------------------------------------------------
REPEAT="${REPEAT:-1}"            # raise for intermittent issues; reproduce.sh reports N/M
STARTUP_TIMEOUT="180"
CLUSTER_TIMEOUT="120"
